# Configure these as Worker secrets/vars, not in frontend JavaScript
ADMIN_PASSWORD=choose-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=https://YOUR-WORKER.workers.dev/auth/callback
# Cloudinary free media storage (R2 is no longer required)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
